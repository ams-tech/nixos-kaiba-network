{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaiba.network/schemas/rpi5-provisioning-probe-report-v1.json",
  "title": "Kaiba Raspberry Pi 5 provisioning-probe validation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "automated",
    "hardware_qualification",
    "mutation_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite": {
      "const": "kaiba-rpi5-provisioning-probe"
    },
    "automated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "checks"
      ],
      "properties": {
        "overall": {
          "enum": [
            "passed",
            "failed",
            "partial"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/automatedCheck"
          }
        }
      }
    },
    "hardware_qualification": {
      "$ref": "#/$defs/hardwareQualification"
    },
    "mutation_eligible": {
      "const": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 80
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^evidence/[A-Za-z0-9._/-]+$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "automatedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "system",
        "status",
        "description",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "system": {
          "enum": [
            "x86_64-linux",
            "aarch64-linux"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-observed"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidencePath"
          },
          "uniqueItems": true
        },
        "source_revision": {
          "$ref": "#/$defs/sourceRevision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "source_revision"
              ]
            },
            "properties": {
              "evidence": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "hardwareQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "description",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidencePath"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
