{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://provisioning.kaiba.network/schemas/rpi5-media-verification-report-v1alpha1.schema.json",
  "title": "Kaiba Raspberry Pi 5 media verification report v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "full_media_digest",
    "regions",
    "gpt_verified",
    "fat_verified",
    "partition_digests_verified",
    "dm_verity_verified",
    "boot_signature_verified",
    "release_lineage_verified",
    "hardware_observed",
    "cold_power_cycle_observed",
    "security_enforced",
    "mutation_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "kaiba.provisioning.rpi5-media-verification-report/v1alpha1"
    },
    "full_media_digest": { "$ref": "#/definitions/digest" },
    "regions": { "$ref": "#/definitions/verified_regions" },
    "gpt_verified": { "const": true },
    "fat_verified": { "const": true },
    "partition_digests_verified": { "const": true },
    "dm_verity_verified": { "const": true },
    "boot_signature_verified": { "const": true },
    "release_lineage_verified": { "const": true },
    "hardware_observed": { "const": false },
    "cold_power_cycle_observed": { "const": false },
    "security_enforced": { "const": false },
    "mutation_eligible": { "const": false }
  },
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "region_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "digest", "verified"],
      "properties": {
        "role": {
          "enum": [
            "primary-gpt",
            "boot-filesystem",
            "root-data",
            "root-hash",
            "tail-zero",
            "backup-gpt"
          ]
        },
        "digest": { "$ref": "#/definitions/digest" },
        "verified": { "const": true }
      }
    },
    "verified_regions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": [
        {
          "allOf": [
            { "$ref": "#/definitions/region_verification" },
            { "properties": { "role": { "const": "primary-gpt" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/region_verification" },
            { "properties": { "role": { "const": "boot-filesystem" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/region_verification" },
            { "properties": { "role": { "const": "root-data" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/region_verification" },
            { "properties": { "role": { "const": "root-hash" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/region_verification" },
            { "properties": { "role": { "const": "tail-zero" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/region_verification" },
            { "properties": { "role": { "const": "backup-gpt" } } }
          ]
        }
      ],
      "additionalItems": false
    }
  }
}
