{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provisioning.kaiba.network/schemas/signing-grant-registry-v1alpha1.schema.json",
  "title": "Kaiba approval-bound signing grant registry v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grants"],
  "properties": {
    "schema_version": {
      "const": "kaiba.provisioning.signing-grant-registry/v1alpha1"
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "$comment": "The gate additionally requires strictly increasing grant_id order and unique request_id values.",
      "items": { "$ref": "#/$defs/grant" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "grant_id", "expires_at", "request"],
      "properties": {
        "schema_version": {
          "const": "kaiba.provisioning.signing-grant/v1alpha1"
        },
        "grant_id": { "$ref": "#/$defs/identifier" },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "request": {
          "$ref": "signing-request-v1alpha1.schema.json"
        }
      }
    }
  }
}
