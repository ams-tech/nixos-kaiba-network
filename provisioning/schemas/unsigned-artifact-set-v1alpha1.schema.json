{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provisioning.kaiba.network/schemas/unsigned-artifact-set-v1alpha1.schema.json",
  "title": "Kaiba Raspberry Pi 5 unsigned artifact set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_revision",
    "expected_customer_key_hash",
    "boot_order_policy",
    "boot_command_line_path",
    "firmware_allowlist",
    "boot_image_size_bytes",
    "persistent_mutable_state",
    "rollback_policy",
    "debug_policy",
    "eeprom_write_protection_policy",
    "toolchain",
    "artifacts",
    "verity",
    "root_integrity_digest",
    "bundle_digest",
    "signing_status"
  ],
  "properties": {
    "schema": {
      "const": "provisioning.kaiba.network/unsigned-artifact-set/v1alpha1"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_customer_key_hash": { "$ref": "#/$defs/digest" },
    "boot_order_policy": {
      "type": "string",
      "enum": [
        "nvme-only",
        "nvme-sd-tftp-restart-development"
      ]
    },
    "boot_command_line_path": { "$ref": "#/$defs/relative_path" },
    "firmware_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relative_path" }
    },
    "boot_image_size_bytes": {
      "type": "integer",
      "minimum": 33554432,
      "maximum": 100663296
    },
    "persistent_mutable_state": { "const": "tmpfs-only" },
    "rollback_policy": { "const": "unimplemented-block-enrollment-ready" },
    "debug_policy": { "const": "videocore-jtag-unlocked-development" },
    "eeprom_write_protection_policy": { "const": "unlocked-development" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cryptsetup", "dosfstools", "mtools"],
      "properties": {
        "cryptsetup": { "$ref": "#/$defs/version" },
        "dosfstools": { "$ref": "#/$defs/version" },
        "mtools": { "$ref": "#/$defs/version" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot_image", "root_data", "root_hash_tree"],
      "properties": {
        "boot_image": { "$ref": "#/$defs/artifact" },
        "root_data": { "$ref": "#/$defs/artifact" },
        "root_hash_tree": { "$ref": "#/$defs/artifact" }
      }
    },
    "verity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "data_block_size",
        "hash_block_size",
        "uuid",
        "data_device",
        "hash_device",
        "mapper"
      ],
      "properties": {
        "algorithm": { "const": "sha256" },
        "data_block_size": { "const": 4096 },
        "hash_block_size": { "const": 4096 },
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "data_device": { "$ref": "#/$defs/partuuid_selector" },
        "hash_device": { "$ref": "#/$defs/partuuid_selector" },
        "mapper": { "const": "/dev/mapper/root" }
      }
    },
    "root_integrity_digest": { "$ref": "#/$defs/digest" },
    "bundle_digest": { "$ref": "#/$defs/digest" },
    "signing_status": { "const": "unsigned" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "relative_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_+.-][A-Za-z0-9_+./-]{0,254}$",
      "allOf": [
        { "not": { "pattern": "^\\." } },
        { "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "\\.\\." } }
      ]
    },
    "partuuid_selector": {
      "type": "string",
      "pattern": "^PARTUUID=[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "PARTUUID=00000000-0000-0000-0000-000000000000" }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[ -~]+$"
    }
  }
}
