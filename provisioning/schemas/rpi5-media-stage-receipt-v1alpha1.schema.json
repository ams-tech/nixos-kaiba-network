{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://provisioning.kaiba.network/schemas/rpi5-media-stage-receipt-v1alpha1.schema.json",
  "title": "Kaiba Raspberry Pi 5 media stage receipt v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "transaction_id",
    "plan_digest",
    "signed_release_manifest_digest",
    "layout_digest",
    "target",
    "attachment_boot_id",
    "attachment_sequence",
    "initial_media_digest",
    "expected_media_digest",
    "observed_media_digest",
    "bytes_written",
    "fsync_complete",
    "reopened_target",
    "independent_readback_required",
    "cold_power_cycle_observed",
    "one_time_settings_changed",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "kaiba.provisioning.rpi5-media-stage-receipt/v1alpha1"
    },
    "status": { "const": "staged_readback_required" },
    "transaction_id": { "$ref": "#/definitions/identifier" },
    "plan_digest": { "$ref": "#/definitions/digest" },
    "signed_release_manifest_digest": { "$ref": "#/definitions/digest" },
    "layout_digest": { "$ref": "#/definitions/digest" },
    "target": { "$ref": "#/definitions/target_binding" },
    "attachment_boot_id": { "$ref": "#/definitions/guid" },
    "attachment_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "initial_media_digest": { "$ref": "#/definitions/digest" },
    "expected_media_digest": { "$ref": "#/definitions/digest" },
    "observed_media_digest": { "$ref": "#/definitions/digest" },
    "bytes_written": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "fsync_complete": { "const": true },
    "reopened_target": { "const": true },
    "independent_readback_required": { "const": true },
    "cold_power_cycle_observed": { "const": false },
    "one_time_settings_changed": { "const": false },
    "receipt_digest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_id_path",
        "model",
        "serial",
        "wwid",
        "size_bytes",
        "logical_sector_size_bytes",
        "physical_sector_size_bytes"
      ],
      "properties": {
        "by_id_path": { "$ref": "#/definitions/by_id_path" },
        "model": { "$ref": "#/definitions/printable_255" },
        "serial": { "$ref": "#/definitions/printable_255" },
        "wwid": { "$ref": "#/definitions/printable_255" },
        "size_bytes": {
          "type": "integer",
          "minimum": 8388608,
          "maximum": 9223372036854775807,
          "multipleOf": 512
        },
        "logical_sector_size_bytes": { "const": 512 },
        "physical_sector_size_bytes": {
          "enum": [512, 1024, 2048, 4096, 8192, 16384, 32768, 65536]
        }
      }
    },
    "by_id_path": {
      "type": "string",
      "pattern": "^/dev/disk/by-id/[^/ \\t\\r\\n]+$",
      "not": {
        "anyOf": [
          { "enum": ["/dev/disk/by-id/.", "/dev/disk/by-id/.."] },
          { "pattern": "-part[0-9]+$" }
        ]
      }
    },
    "printable_255": {
      "type": "string",
      "pattern": "^(?:[!-~]|[!-~][ -~]{0,253}[!-~])$"
    }
  }
}
