{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://provisioning.kaiba.network/schemas/rpi5-media-staging-plan-v1alpha1.schema.json",
  "title": "Kaiba Raspberry Pi 5 media staging plan v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "release",
    "target",
    "layout",
    "initial_media_digest",
    "expected_media_digest",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "kaiba.provisioning.rpi5-media-staging-plan/v1alpha1"
    },
    "transaction_id": { "$ref": "#/definitions/identifier" },
    "release": { "$ref": "#/definitions/release_binding" },
    "target": { "$ref": "#/definitions/target_binding" },
    "layout": {
      "$ref": "rpi5-device-media-layout-v1alpha1.schema.json"
    },
    "initial_media_digest": { "$ref": "#/definitions/digest" },
    "expected_media_digest": { "$ref": "#/definitions/digest" },
    "plan_digest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "release_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "signed_release_manifest_digest",
        "capsule_digest"
      ],
      "properties": {
        "release_id": { "$ref": "#/definitions/identifier" },
        "signed_release_manifest_digest": {
          "$ref": "#/definitions/digest"
        },
        "capsule_digest": { "$ref": "#/definitions/digest" }
      }
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_id_path",
        "model",
        "serial",
        "wwid",
        "size_bytes",
        "logical_sector_size_bytes",
        "physical_sector_size_bytes"
      ],
      "properties": {
        "by_id_path": { "$ref": "#/definitions/by_id_path" },
        "model": { "$ref": "#/definitions/printable_255" },
        "serial": { "$ref": "#/definitions/printable_255" },
        "wwid": { "$ref": "#/definitions/printable_255" },
        "size_bytes": {
          "type": "integer",
          "minimum": 8388608,
          "maximum": 9223372036854775807,
          "multipleOf": 512
        },
        "logical_sector_size_bytes": { "const": 512 },
        "physical_sector_size_bytes": {
          "enum": [512, 1024, 2048, 4096, 8192, 16384, 32768, 65536]
        }
      }
    },
    "by_id_path": {
      "type": "string",
      "pattern": "^/dev/disk/by-id/[^/ \\t\\r\\n]+$",
      "not": {
        "anyOf": [
          { "enum": ["/dev/disk/by-id/.", "/dev/disk/by-id/.."] },
          { "pattern": "-part[0-9]+$" }
        ]
      }
    },
    "printable_255": {
      "type": "string",
      "pattern": "^(?:[!-~]|[!-~][ -~]{0,253}[!-~])$"
    }
  }
}
