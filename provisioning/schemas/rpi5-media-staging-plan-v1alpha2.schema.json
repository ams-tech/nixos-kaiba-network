{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://provisioning.kaiba.network/schemas/rpi5-media-staging-plan-v1alpha2.schema.json",
  "title": "Kaiba Raspberry Pi 5 media staging plan v1alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "release",
    "target",
    "layout",
    "expected_media_digest",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "kaiba.provisioning.rpi5-media-staging-plan/v1alpha2"
    },
    "transaction_id": { "$ref": "#/definitions/identifier" },
    "release": { "$ref": "#/definitions/release_binding" },
    "target": { "$ref": "#/definitions/target_binding" },
    "layout": {
      "$ref": "rpi5-device-media-layout-v1alpha1.schema.json"
    },
    "expected_media_digest": { "$ref": "#/definitions/digest" },
    "plan_digest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "release_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "signed_release_manifest_digest",
        "capsule_digest"
      ],
      "properties": {
        "release_id": { "$ref": "#/definitions/identifier" },
        "signed_release_manifest_digest": {
          "$ref": "#/definitions/digest"
        },
        "capsule_digest": { "$ref": "#/definitions/digest" }
      }
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_bytes",
        "logical_sector_size_bytes"
      ],
      "properties": {
        "size_bytes": {
          "type": "integer",
          "minimum": 8388608,
          "maximum": 9223372036854775807,
          "multipleOf": 512
        },
        "logical_sector_size_bytes": { "const": 512 }
      }
    }
  }
}
