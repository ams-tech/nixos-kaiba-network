{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://provisioning.kaiba.network/schemas/rpi5-media-binding-v1alpha1.schema.json",
  "title": "Kaiba Raspberry Pi 5 on-media release binding v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transaction_id",
    "release_id",
    "signed_release_manifest_digest",
    "capsule_digest",
    "boot_image_digest",
    "boot_signature_digest",
    "root_data_digest",
    "root_hash_tree_digest",
    "root_integrity_digest",
    "verity_root_hash",
    "boot_partition_guid",
    "data_partition_guid",
    "hash_partition_guid"
  ],
  "properties": {
    "schema_version": {
      "const": "kaiba.provisioning.rpi5-media-binding/v1alpha1"
    },
    "transaction_id": { "$ref": "#/definitions/identifier" },
    "release_id": { "$ref": "#/definitions/identifier" },
    "signed_release_manifest_digest": { "$ref": "#/definitions/digest" },
    "capsule_digest": { "$ref": "#/definitions/digest" },
    "boot_image_digest": { "$ref": "#/definitions/digest" },
    "boot_signature_digest": { "$ref": "#/definitions/digest" },
    "root_data_digest": { "$ref": "#/definitions/digest" },
    "root_hash_tree_digest": { "$ref": "#/definitions/digest" },
    "root_integrity_digest": { "$ref": "#/definitions/digest" },
    "verity_root_hash": { "$ref": "#/definitions/digest" },
    "boot_partition_guid": { "$ref": "#/definitions/guid" },
    "data_partition_guid": { "$ref": "#/definitions/guid" },
    "hash_partition_guid": { "$ref": "#/definitions/guid" }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
