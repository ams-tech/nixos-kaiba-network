{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provisioning.kaiba.network/schemas/rpi5-signing-approval-v1alpha1.schema.json",
  "title": "Kaiba Raspberry Pi 5 reviewer-attributed release-signing approval v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "approval_digest",
    "decision",
    "reviewer_id",
    "approved_at",
    "expires_at",
    "release_id",
    "source_revision",
    "release_intent_digest",
    "signing_inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "kaiba.provisioning.rpi5-signing-approval/v1alpha1"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^approval:[0-9a-f]{64}$"
    },
    "approval_digest": { "$ref": "#/$defs/digest" },
    "decision": { "const": "approved" },
    "reviewer_id": { "$ref": "#/$defs/identifier" },
    "approved_at": { "$ref": "#/$defs/time" },
    "expires_at": { "$ref": "#/$defs/time" },
    "release_id": { "$ref": "#/$defs/identifier" },
    "source_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "release_intent_digest": { "$ref": "#/$defs/digest" },
    "signing_inputs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "$ref": "#/$defs/boot_image" },
        { "$ref": "#/$defs/eeprom_bootcode" },
        { "$ref": "#/$defs/eeprom_bootsys" },
        { "$ref": "#/$defs/eeprom_config" },
        { "$ref": "#/$defs/owned_recovery_bootcode" }
      ],
      "items": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "digest", "size_bytes"],
      "properties": {
        "role": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100663296
        }
      }
    },
    "boot_image": {
      "allOf": [
        { "$ref": "#/$defs/input" },
        { "properties": { "role": { "const": "rpi5.boot_image" } } }
      ]
    },
    "eeprom_bootcode": {
      "allOf": [
        { "$ref": "#/$defs/input" },
        { "properties": { "role": { "const": "rpi5.eeprom_bootcode" } } }
      ]
    },
    "eeprom_bootsys": {
      "allOf": [
        { "$ref": "#/$defs/input" },
        { "properties": { "role": { "const": "rpi5.eeprom_bootsys" } } }
      ]
    },
    "eeprom_config": {
      "allOf": [
        { "$ref": "#/$defs/input" },
        { "properties": { "role": { "const": "rpi5.eeprom_config" } } }
      ]
    },
    "owned_recovery_bootcode": {
      "allOf": [
        { "$ref": "#/$defs/input" },
        { "properties": { "role": { "const": "rpi5.owned_recovery_bootcode" } } }
      ]
    }
  },
  "$comment": "Go validation additionally checks the domain-separated approval digest and derived ID, time ordering and lifetime, exact release-intent equality, and exact deterministic five-grant registry equality."
}
